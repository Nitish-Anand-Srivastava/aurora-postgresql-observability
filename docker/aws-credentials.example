# Copy to ./aws-credentials (gitignored) and fill in real values ONLY if you want the local
# docker compose stack's yace container to make real AWS CloudWatch calls. This is entirely
# optional -- see docker/README.md and docker-compose.yml's top-of-file comment.
[default]
aws_access_key_id = REPLACE_ME
aws_secret_access_key = REPLACE_ME
# aws_session_token = REPLACE_ME   # only if using temporary/STS credentials
