# Environment template for prometheus-community/postgres_exporter v0.20.1
# https://github.com/prometheus-community/postgres_exporter
#
# Copy this file to postgres_exporter.env (gitignored) and fill in real values, OR
# render it via your secrets manager at deploy time. NEVER commit the copy with real values.
#
# Used by systemd/postgres_exporter.service via `EnvironmentFile=`.

# --- Connection (single-target mode; this is the default/recommended mode) ---
# Full libpq-style DSN. Prefer sslmode=verify-full against Aurora's RDS CA bundle in production.
# Aurora endpoints are cluster/instance DNS names such as
# <identifier>.cluster-<random>.<region>.rds.amazonaws.com — replace the .invalid placeholder
# below with your real writer or reader endpoint (or point at the reader endpoint for a
# read-only exporter instance).
DATA_SOURCE_URI=aurora-writer.cluster-example.us-east-1.rds.invalid:5432/postgres?sslmode=verify-full&sslrootcert=/etc/postgres_exporter/global-bundle.pem

# Username for the least-privilege role created by sql/create_monitoring_role.sql.
DATA_SOURCE_USER=pg_exporter

# Preferred over DATA_SOURCE_PASS: path to a file containing ONLY the password, mounted with
# restrictive permissions (0400, owned by the postgres_exporter service user). This keeps the
# secret out of `ps`, environment dumps, and systemd journal exports.
# https://github.com/prometheus-community/postgres_exporter#quick-start
DATA_SOURCE_PASS_FILE=/etc/postgres_exporter/pgpassword
# Do NOT set DATA_SOURCE_PASS (plaintext env var) alongside DATA_SOURCE_PASS_FILE.

# --- Exporter behavior ---
PG_EXPORTER_WEB_TELEMETRY_PATH=/metrics
PG_EXPORTER_DISABLE_DEFAULT_METRICS=false
PG_EXPORTER_COLLECTION_TIMEOUT=10s

# Deprecated upstream (kept unset here on purpose) — do not re-enable without reading
# docs/metrics-reference.md#deprecated-optional-mechanisms:
# PG_EXPORTER_EXTEND_QUERY_PATH=/etc/postgres_exporter/queries.yaml
# PG_EXPORTER_AUTO_DISCOVER_DATABASES=false
# PG_EXPORTER_CONSTANT_LABELS=
