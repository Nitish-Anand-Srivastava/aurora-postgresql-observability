{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowYaceHostToAssumeThisRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/EXAMPLE-yace-host-instance-role"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "REPLACE_WITH_RANDOM_EXTERNAL_ID"
        }
      }
    }
  ]
}
